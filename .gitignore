# Volume unificato dati (nuovo sistema)
data/
!data/.gitkeep

# Database (legacy - ora in data/db/)
builder/db/*.db
builder/db/*.db-shm
builder/db/*.db-wal

# Uploads (legacy - ora in data/uploads/)
builder/uploads/*
!builder/uploads/.gitkeep

# Export temporanei (legacy - ora in data/export/)
builder/export/*
!builder/export/.gitkeep

# Assets generati (legacy - ora in data/assets/)
assets/img/*
!assets/img/.gitkeep
assets/css/style.css

# Index esportato (opzionale - decommenta se vuoi versionarlo)
# index.html

# Editor e IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Cache
.cache/
*.cache

# Backup
*.bak
*.backup
*.old

# OS
Thumbs.db
desktop.ini

# Docker
backups/
*.tar.gz
